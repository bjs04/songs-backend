# TiDB Cloud / MySQL
DB_URL=jdbc:mysql://your-database-host:4000/your_database?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3
DB_USERNAME=your-database-username
DB_PASSWORD=your-database-password

# Google Gemini
GOOGLE_API_KEY=your-google-api-key

# Application API authentication
API_SECRET_KEY=your-application-api-secret

# Frontend CORS origin(s), comma-separated if needed
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Set to true once to backfill existing MySQL songs into Pinecone, then set back to false
VECTOR_STORE_BACKFILL_ON_STARTUP=false

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-pinecone-index-name
PINECONE_NAMESPACE=songs-app
